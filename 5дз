#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <math.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, ".UTF8"); 

    double x, y, d = 1.0;

    
    printf("Введите x и y: ");
    scanf("%lf %lf", &x, &y);

    // Вычисление числителя и знаменателя
    double ch = pow(cos(y), 3) + pow(2, x) * d;
    double zn = exp(y) + log(pow(sin(x), 2) + 7.4);

    double F = ch / zn;

    printf("Результат F = %e (или %.6f)\n", F, F);

    return 0;
}
